__pycache__/
*.egg-info/
.pytest_cache/
build/
dist/
.venv/
workspaces/
*.pt
!tests/equivalence/fixtures/*.pt
# The acceptance run's own output: workspaces, checkpoints and scoring directories, none of
# which belongs in git -- except the two small JSON records of the 2026-09-07 equivalence run,
# which are the only provenance a reader off this machine has for the numbers the docs quote.
tests/acceptance/_runs/**
!tests/acceptance/_runs/
!tests/acceptance/_runs/2026-09-07-equiv/
!tests/acceptance/_runs/2026-09-07-equiv/results.json
!tests/acceptance/_runs/2026-09-07-equiv/reference.json

# Agent-harness scratch, created by whatever tool a contributor happens to use.
# Not part of the package and not something a user should inherit.
.claude/
.mcp.json
